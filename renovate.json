{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Belgrade",
  "schedule": [
    "* 0-8 * * 6"
  ],
  "ignorePaths": [
    "apps/immich/values.yaml",
    "infrastructure/tailscale-operator/values.yaml"
  ],
  "flux": {
    "managerFilePatterns": [
      "/\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)helmrelease\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/infrastructure/local-path-provisioner/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Image tags pinned with a `# renovate:` hint in HelmRelease values",
      "managerFilePatterns": [
        "/(^|/)helmrelease\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+tag: (?<currentValue>\\S+)"
      ]
    }
  ]
}
